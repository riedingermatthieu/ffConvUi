{
  "input": "in.mkv",
  "output": "out.mp4",
  "muxer_options": { "movflags": "+faststart" },
  "overwrite": false,
  "metadata": { "title": "Converted with convcli" },
  "streams": [
    { "input": 0, "action": "transcode", "encoder": "libx265",
      "options": { "crf": 28, "preset": "fast" },
      "filters": [ { "name": "scale", "options": { "w": 1280, "h": -2 } },
                   { "name": "fps", "options": { "fps": 25 } } ] },
    { "input": 1, "action": "transcode", "encoder": "aac", "options": { "b": "192k" } },
    { "input": 2, "action": "transcode", "encoder": "mov_text" }
  ]
}
